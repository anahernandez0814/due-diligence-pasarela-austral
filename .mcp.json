{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PAT}",
        "X-MCP-Toolsets": "repos,issues,pull_requests,projects"
      }
    },
    "pasarela": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--quiet", "python", "-m", "servidor_mcp"]
    }
  }
}
